PORT=8080
# 宿主机接入同一 PostgreSQL。也可以在环境中设置 DATABASE_URL。
PG_PORT=55432
# 构建机器使用其他基础镜像时，可覆盖三个基础镜像的完整引用。
# WORKBENCH_PYTHON_IMAGE=python:3.12-slim
# WORKBENCH_NODE_IMAGE=node:24-alpine
# WORKBENCH_NGINX_IMAGE=nginx:stable-alpine
DEMO_DATA=1
ENABLE_SIMULATOR=1
AUTO_ASSIGN=0
MEDIACRAWLER_URL=
# 企业自有作品白名单，格式为 dy:作品ID,xhs:笔记ID
MEDIACRAWLER_OWN_POSTS=
BRAVE_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_PAGE_TOKEN=
META_GRAPH_VERSION=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_PHONE_NUMBER_IDS=
IG_APP_SECRET=
IG_VERIFY_TOKEN=
IG_ACCOUNT_IDS=
X_CLIENT_SECRET=
X_USER_IDS=
TIKTOK_APP_SECRET=
TIKTOK_BUSINESS_IDS=
TELEGRAM_BOT_ID=
TELEGRAM_WEBHOOK_SECRET=
LINE_BOT_USER_ID=
LINE_CHANNEL_SECRET=
WX_CORP_ID=
WX_KF_SECRET=
WX_TOKEN=
WX_AES_KEY=

# Set to 1 when serving the workspace over HTTPS.
SESSION_COOKIE_SECURE=0
