PORT=8080
DEMO_DATA=1
ENABLE_SIMULATOR=1
AUTO_ASSIGN=0
# 可选。仅在首次启动空数据库时用于创建 admin。填入单引号包裹的密码哈希值。
ADMIN_BOOTSTRAP_PASSWORD_HASH=
# 本机实时采集服务地址，Docker Desktop 示例 http://host.docker.internal:8092
MEDIACRAWLER_URL=
# 企业自有作品白名单，格式为 dy:作品ID,xhs:笔记ID
MEDIACRAWLER_OWN_POSTS=
# Compose 优先使用工作台专用 Exa 密钥
KOOYING_EXA_API_KEY=
BRAVE_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_PAGE_TOKEN=
META_GRAPH_VERSION=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_PHONE_NUMBER_IDS=
IG_APP_SECRET=
IG_VERIFY_TOKEN=
IG_ACCOUNT_IDS=
X_CLIENT_SECRET=
X_USER_IDS=
TIKTOK_APP_SECRET=
TIKTOK_BUSINESS_IDS=
TELEGRAM_BOT_ID=
TELEGRAM_WEBHOOK_SECRET=
LINE_BOT_USER_ID=
LINE_CHANNEL_SECRET=
WX_CORP_ID=
WX_KF_SECRET=
WX_TOKEN=
WX_AES_KEY=

# Set to 1 when serving the workspace over HTTPS.
SESSION_COOKIE_SECURE=0
